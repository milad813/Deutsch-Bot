# =============================================================================
# Deutsch-Bot — Environment variable template
# =============================================================================
# Copy this file to `.env` and fill in real values for local development.
# Production deployments should inject these via the host environment / secrets
# manager instead of using a `.env` file.
#
# Notes:
#   - Values shown here are SAFE placeholders (no real secrets).
#   - Booleans accept: 1 / true / yes / on   (and 0 / false / no / off)
#   - This file should NOT be committed (already covered by .gitignore).
# =============================================================================


# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token issued by @BotFather. REQUIRED.
TELEGRAM_BOT_TOKEN=

# Telegram numeric user id of the bot owner. Used as the only authorized user
# unless ALLOW_PUBLIC_ACCESS=1. Set to 0 (default) to require an explicit id.
ADMIN_USER_ID=0

# When set to 1, every Telegram user may use the bot (intended for public
# deployments). Keep 0 for private/single-user setups.
ALLOW_PUBLIC_ACCESS=0


# ─── Storage ─────────────────────────────────────────────────────────────────
# SQLite database file path. Relative paths are resolved from the project root.
DB_PATH=words.db

# Directory where generated TTS audio files are cached.
AUDIO_CACHE_DIR=audio_cache


# ─── Bot mode & LLM ──────────────────────────────────────────────────────────
# Operating mode for the bot:
#   - offline : no LLM calls (recommended default for single-user)
#   - hybrid  : LLM used opportunistically when available
#   - online  : LLM is mandatory (bot won't work without it)
BOT_MODE=offline

# Primary Groq API key. Use GROQ_API_KEYS instead if you have several keys and
# want round-robin fallback. Leave empty in offline mode.
GROQ_API_KEY=

# Optional comma-separated list of additional Groq keys. If non-empty it
# overrides GROQ_API_KEY for client construction.
GROQ_API_KEYS=

# Default Groq chat model.
GROQ_MODEL=llama-3.3-70b-versatile

# Max output tokens per LLM request.
GROQ_MAX_TOKENS=1024

# Sampling temperature for LLM calls (0.0 = deterministic, 1.0 = creative).
GROQ_TEMPERATURE=0.7

# Hard timeout (seconds) for non-quiz LLM requests.
LLM_TIMEOUT_SECONDS=8

# Hard timeout (seconds) for quiz-specific LLM calls (must be short).
QUIZ_LLM_TIMEOUT_SECONDS=2.5


# ─── Flashcard / SRS ─────────────────────────────────────────────────────────
# Maximum cards loaded into a single flashcard session queue.
FLASHCARD_QUEUE_LIMIT=20

# Maximum number of *new* (never-seen) cards mixed into a flashcard session.
FLASHCARD_NEW_LIMIT=5

# Automatically delete ephemeral TTS audio messages after N seconds.
# Set to 0 to disable auto-deletion.
TTS_AUTO_DELETE_SECONDS=60


# ─── Daily reminder (user-local time) ─────────────────────────────────────────
# Local hour (0–23) at which the daily reminder fires.
DAILY_REMINDER_HOUR_LOCAL=9

# Local minute (0–59) for the daily reminder.
DAILY_REMINDER_MINUTE_LOCAL=0

# User timezone offset (hours from UTC). Example: Iran = +3:30.
USER_TIMEZONE_OFFSET_HOURS=3

# User timezone offset (minutes component). Example: Iran = +30.
USER_TIMEZONE_OFFSET_MINUTES=30


# ─── Backups ─────────────────────────────────────────────────────────────────
# Keep daily DB backups newer than this many days.
BACKUP_KEEP_DAYS=14

# Hard cap on the number of retained backups (oldest beyond this are deleted).
BACKUP_KEEP_MAX=30